# Copy thành .env (make env) rồi điền giá trị. File .env KHÔNG được commit.
# Secret của client "backoffice" để xin token client_credentials, phải giống OAUTH_BACKOFFICE_CLIENT_SECRET bên auth-service.
OAUTH_CLIENT_SECRET=change-me
# Tuỳ chọn: ghi đè config.yml
# REST_SERVER_ADDR=:8080
# OAUTH_AUTH_URL=http://localhost:9000
# WALLET_SERVICE_ADDR=localhost:50051
# USER_SERVICE_URL=http://localhost:8082
# AUTHZ_SERVICE_ADDR=localhost:50052
